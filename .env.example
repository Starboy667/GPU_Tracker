# Copy to .env for local development (`set -a; . ./.env; set +a; python -m pricewatch`).
# In Kubernetes these come from the Deployment and the pricewatch-secret Secret.

# Required. Signs sessions and encrypts stored channel credentials. Changing it signs everyone
# out and makes saved channels unreadable (they must be entered again).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# First account, created only while no account exists. Password: at least 10 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public address of the app: used in notification links. An http:// address also turns off
# Secure cookies, which is what you want on localhost.
BASE_URL=http://localhost:8000

# Where the SQLite database lives.
DATA_DIR=data

# Optional
# APP_TIMEZONE=Europe/Paris        # days and displayed times
# PORT=8000
# SCHEDULER_ENABLED=true           # false: no automatic checks ("Check now" still works)
# ALLOW_PRIVATE_NOTIFY_URLS=false  # true: channels may target private/in-cluster hosts (ntfy, Gotify...)
